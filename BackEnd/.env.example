# ── Server Config ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ── Primary Database (MongoDB Atlas or Local MongoDB) ──────
DB_CONNECT_KEY=mongodb+srv://<username>:<password>@cluster.mongodb.net/battleground?retryWrites=true&w=majority

# ── Redis Database (Local Redis or Upstash/Redis Labs) ────
# Leave empty or omit if running local Redis without password
REDIS_PASSWORD=your_redis_password

# ── JWT Authentication ─────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here

# ── Code Judging Engine (Piston API - Free) ───────────────
COMPILER_API=https://emkc.org/api/v2/piston/execute

# ── AI Services (Groq & Gemini) ────────────────────────────
# Groq API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Gemini API Key (Free tier at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_GRADING_MODEL=gemini-2.5-flash

# ── Google OAuth2 & Nodemailer OTP Emails ──────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_gmail_oauth2_refresh_token
GOOGLE_SENDER_EMAIL=your_email@gmail.com
AUTH_FROM_EMAIL="BattleGround <your_email@gmail.com>"

# ── Optional OTP & Rate Limit Settings ────────────────────
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_PER_IP=3
AUTH_RATE_LIMIT_PER_EMAIL=3
